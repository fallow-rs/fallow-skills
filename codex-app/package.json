{
  "name": "fallow-codex-app",
  "version": "0.0.0",
  "private": true,
  "description": "Source of the Fallow app for Codex: an MCP server and MCP App that the fallow plugin bundles.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "config": {
    "fallowForTests": "3.31.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "harness": "node scripts/harness/serve.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/mcp-extensions": "^0.1.0",
    "jsonc-parser": "^3.3.1",
    "preact": "^11.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
