{
  "name": "fallow-codex-app",
  "version": "0.0.0",
  "private": true,
  "description": "Source of the Fallow app for Codex: an MCP server and MCP App that the fallow plugin bundles.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "config": {
    "fallowForTests": "3.31.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../agent-view/tsconfig.json",
    "test": "node --test test/*.test.ts ../agent-view/test/*.test.ts",
    "harness": "node scripts/harness/serve.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@openai/mcp-extensions": "^0.2.1",
    "jsonc-parser": "^3.3.1",
    "preact": "^11.1.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "zod": "4.6.7",
    "@openai/mcp-extensions": {
      "@modelcontextprotocol/ext-apps": "$@modelcontextprotocol/ext-apps"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
